VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://localhost:5000
VITE_PORT=3000
VITE_OSM_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
VITE_MAP_DEFAULT_LAT=20.2961
VITE_MAP_DEFAULT_LNG=85.8245
VITE_MAP_DEFAULT_ZOOM=13
